<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="$(BurbujaRoot)/src/Burbuja.Hosting/Burbuja.Hosting.csproj" />
    <None Update="client/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RemoveStaticPluginPublishManifests" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.RelativePath)' == 'plugin.json'" />
    </ItemGroup>
  </Target>
</Project>
