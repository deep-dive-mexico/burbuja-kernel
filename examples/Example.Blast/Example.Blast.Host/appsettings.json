{
  "urls": "http://127.0.0.1:18496",
  "Kernel": {
    "Role": "control-plane",
    "NodeId": "example-blast",
    "Seed": false,
    "PluginsDirectory": "plugins"
  },
  "Auth": {
    "ApiKeys": [
      { "Key": "blast-operator-dev-key", "PrincipalId": "operator", "Roles": ["Owner"] }
    ]
  },
  "Realtime": {
    "Enabled": true,
    "Placement": "least-loaded",
    "Guests": { "Enabled": true },
    "Servers": [
      { "Id": "blast-a", "Region": "local", "MaxLobbies": 4 },
      { "Id": "blast-b", "Region": "local", "MaxLobbies": 4 }
    ]
  },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  }
}
