@page "/workbench"

<PageTitle>Example Workbench</PageTitle>
<h1>Example Workbench</h1>
<p>This executable owns this portal. Its notes provider is installed as a separate plugin.</p>
<p>Use the ARM API under <code>Example.Workbench/notes</code> to create notes and read their event trace.</p>
<form method="post" action="/workbench/signout" data-enhance="false">
    <button type="submit">Sign out</button>
</form>
