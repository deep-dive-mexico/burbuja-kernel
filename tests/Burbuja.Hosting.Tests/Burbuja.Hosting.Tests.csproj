<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <WorkbenchRoot>$(MSBuildThisFileDirectory)../../examples/Example.Workbench</WorkbenchRoot>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <ProjectReference Include="../../src/Burbuja.Hosting/Burbuja.Hosting.csproj" />
    <ProjectReference Include="../../plugins/Burbuja.Plugins.Store.Sqlite/Burbuja.Plugins.Store.Sqlite.csproj" />
    <ProjectReference Include="../../plugins/Burbuja.Plugins.Store.Connected/Burbuja.Plugins.Store.Connected.csproj" />
    <ProjectReference Include="../../examples/Example.Connected/Example.Connected.csproj" />
    <ProjectReference Include="../../examples/Example.Workbench/Example.Workbench.Host/Example.Workbench.Host.csproj" />
    <ProjectReference Include="../../examples/Example.Workbench/Example.Workbench.Plugin/Example.Workbench.Plugin.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="StageWorkbenchFixtures" AfterTargets="Build">
    <RemoveDir Directories="$(OutDir)plugin-fixture;$(OutDir)host-fixture" />
    <ItemGroup>
      <WorkbenchPluginFiles Include="$(WorkbenchRoot)/Example.Workbench.Plugin/bin/$(Configuration)/$(TargetFramework)/**/*" />
      <WorkbenchHostFiles Include="$(WorkbenchRoot)/Example.Workbench.Host/bin/$(Configuration)/$(TargetFramework)/**/*" />
      <WorkbenchAssetManifests Include="$(WorkbenchRoot)/Example.Workbench.Host/bin/$(Configuration)/$(TargetFramework)/Example.Workbench.Host.staticwebassets.*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(WorkbenchPluginFiles)" DestinationFiles="@(WorkbenchPluginFiles-&gt;'$(OutDir)plugin-fixture/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(WorkbenchHostFiles)" DestinationFiles="@(WorkbenchHostFiles-&gt;'$(OutDir)host-fixture/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(WorkbenchAssetManifests)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
