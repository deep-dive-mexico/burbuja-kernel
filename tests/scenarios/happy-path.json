{
  "id": "happy-path",
  "defaultUsage": { "inputTokens": 100, "outputTokens": 50, "cacheReadInputTokens": 0, "cacheWriteInputTokens": 0 },
  "agent": {
    "turns": [
      {
        "when": { "firstTurn": true },
        "emit": {
          "stopReason": "tool_use",
          "blocks": [
            { "type": "tool_use", "id": "tu_write", "name": "write_file", "input": { "path": "hello.txt", "content": "hello" } }
          ]
        }
      },
      {
        "when": { "any": true },
        "emit": {
          "stopReason": "end_turn",
          "blocks": [{ "type": "text", "text": "done" }]
        }
      }
    ]
  },
  "supervisor": {
    "decisions": [
      { "when": { "any": true }, "emit": { "decision": "allow", "reason": "ok", "confidence": 0.9 } }
    ]
  }
}
