{
  "id": "gray-zone-escalate-defer",
  "defaultUsage": { "inputTokens": 80, "outputTokens": 40, "cacheReadInputTokens": 0, "cacheWriteInputTokens": 0 },
  "agent": {
    "turns": [
      {
        "when": { "firstTurn": true },
        "emit": {
          "stopReason": "tool_use",
          "blocks": [
            { "type": "tool_use", "id": "tu_defer", "name": "bash", "input": { "command": "unknowncmd --defer" } }
          ]
        }
      },
      {
        "when": { "any": true },
        "emit": {
          "stopReason": "end_turn",
          "blocks": [{ "type": "text", "text": "resumed" }]
        }
      }
    ]
  },
  "supervisor": {
    "decisions": [
      { "when": { "any": true }, "emit": { "decision": "escalate", "reason": "defer me", "confidence": 0.8 } }
    ]
  }
}
