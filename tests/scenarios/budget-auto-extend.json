{
  "id": "budget-auto-extend",
  "defaultUsage": { "inputTokens": 10, "outputTokens": 10, "cacheReadInputTokens": 0, "cacheWriteInputTokens": 0 },
  "agent": {
    "turns": [
      {
        "when": { "firstTurn": true },
        "fault": { "usageBlowup": 1000000 },
        "emit": {
          "stopReason": "tool_use",
          "blocks": [
            { "type": "tool_use", "id": "tu_list", "name": "list_dir", "input": { "path": "." } }
          ]
        }
      },
      {
        "when": { "any": true },
        "emit": {
          "stopReason": "end_turn",
          "blocks": [{ "type": "text", "text": "extended" }]
        }
      }
    ]
  },
  "supervisor": {
    "decisions": [
      { "when": { "any": true }, "emit": { "decision": "allow", "reason": "ok", "confidence": 0.9 } }
    ]
  }
}
