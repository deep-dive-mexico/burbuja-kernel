<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Burbuja.TestKit</RootNamespace>
    <Description>Black-box helpers for out-of-tree Burbuja Server E2E suites: publish, stage plugins, spawn a Host, drive ARM over HTTP.</Description>
    <IsPackable>true</IsPackable>
    <PackageId>Burbuja.TestKit</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Burbuja.Core.Abstractions/Burbuja.Core.Abstractions.csproj" />
    <ProjectReference Include="../Burbuja.Core.Sdk/Burbuja.Core.Sdk.csproj" />
  </ItemGroup>
</Project>
