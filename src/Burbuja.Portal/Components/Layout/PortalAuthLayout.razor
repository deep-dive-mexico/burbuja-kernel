@namespace Burbuja.Portal.Components.Layout
@inherits LayoutComponentBase
@inject IPortalArm Arm
@inject PortalRegistry Portals

<div class="shell">
    <header class="topbar">
        <span class="brand-name">@Scope.Title</span>
        <div class="topbar-right">
            <button type="button" class="btn btn-ghost theme-toggle" data-theme-toggle
                    aria-label="@(Scope.Lang == "es" ? "Cambiar tema" : "Change theme")">
                <span class="theme-glyph theme-glyph-light"><Icon Name="theme-light" /></span>
                <span class="theme-glyph theme-glyph-dark"><Icon Name="theme-dark" /></span>
            </button>
        </div>
    </header>
    <main class="content">
        @if (_session is not null && !_session.HasPortal(Scope.Id))
        {
            <div class="alert alert-warn" role="alert" data-error="noaccess">
                <strong>@(Scope.Lang == "es" ? "Esta cuenta no tiene acceso a esta consola." : "This account cannot open this console.")</strong>
                @foreach (var portal in Portals.All.Where(p => _session.HasPortal(p.Id)))
                {
                    <a class="btn" href="@portal.Home">@portal.Title</a>
                }
            </div>
        }
        @Body
    </main>
</div>

@code {
    [CascadingParameter] public PortalScope Scope { get; set; } = PortalScope.Kernel;
    private PortalSession? _session;
    protected override async Task OnInitializedAsync() => _session = await Arm.SessionAsync();
}
